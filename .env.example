# Lahra-MT6-Pro — environment variables
# Copy to .env and fill in your values.
# .env is git-ignored; .env.example is committed.

# ── Frontend (Vite) ──────────────────────────────────────────────────────────
# WebSocket feed URL (Python Brain)
VITE_WS_FEED_URL=ws://localhost:8000/ws/ticks

# ── Rust/Tauri backend ───────────────────────────────────────────────────────
# Python Brain base URL (FastAPI)
BRAIN_URL=http://localhost:8000

# Java Executor base URL (Spring Boot)
EXECUTOR_URL=http://localhost:8080

# ── Logging ──────────────────────────────────────────────────────────────────
# Rust log filter (info | debug | trace)
RUST_LOG=lahra_mt6_pro=info,tauri=warn
